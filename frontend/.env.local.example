# ════════════════════════════════════════════════════════════════════════════
# Firebase Frontend (.env.local) - Next.js Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# IMPORTANT:
# 1. Copy this file to .env.local (DO NOT COMMIT .env.local TO GIT)
# 2. Fill in all Firebase credentials from your web app config
# 3. NEXT_PUBLIC_* prefix means these are exposed to browser (safe, no secrets)
# 4. Frontend will use these to initialize Firebase SDK
#
# ════════════════════════════════════════════════════════════════════════════

# ── FIREBASE WEB SDK CONFIG (Frontend Client) ───────────────────────────────
# Get this from: Firebase Console → Project Settings → 
#   → "Your apps" section → Click your web app → "SDK setup and configuration"
#
# You'll see a config like:
# const firebaseConfig = {
#   apiKey: "AIzaSyDEWxxxxxxx",
#   authDomain: "solar-ai-optimization-xxxxx.firebaseapp.com",
#   projectId: "solar-ai-optimization-xxxxx",
#   storageBucket: "solar-ai-optimization-xxxxx.appspot.com",
#   messagingSenderId: "123456789",
#   appId: "1:123456789:web:abcd1234abcd1234",
# };

# Unique API key for Firebase Web SDK (public, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDEW1234567890abcdefghijklmnop"

# Firebase authentication domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="solar-ai-optimization-xxxxx.firebaseapp.com"

# Firebase project ID (same as backend FIREBASE_PROJECT_ID)
NEXT_PUBLIC_FIREBASE_PROJECT_ID="solar-ai-optimization-xxxxx"

# Cloud Storage bucket name
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="solar-ai-optimization-xxxxx.appspot.com"

# Firebase Cloud Messaging sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"

# Firebase app ID
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcd1234abcd1234"

# ────────────────────────────────────────────────────────────────────────────
# BACKEND API CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# ────────────────────────────────────────────────────────────────────────────
# NEXT.js ENVIRONMENT
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"  # development | production

# ────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS (Optional)
# ────────────────────────────────────────────────────────────────────────────

# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ────────────────────────────────────────────────────────────────────────────
# ANALYTICS & MONITORING (Optional)
# ────────────────────────────────────────────────────────────────────────────

# Google Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Sentry error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"
